{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/personal-workspace-governance/policy-exception.schema.json",
  "title": "Policy Exception",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "id", "rule_id", "target", "disposition", "reason", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["workspace_object", "surface", "relationship", "machine"]},
        "id": {"type": "string", "minLength": 1}
      }
    },
    "disposition": {"enum": ["defer", "waive"]},
    "reason": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["manual", "date", "condition"]},
        "review_at": {"type": "string", "format": "date-time"},
        "condition": {"type": "string", "minLength": 1}
      }
    }
  }
}
