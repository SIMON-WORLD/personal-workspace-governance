{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/personal-workspace-governance/surface.schema.json",
  "title": "Surface",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "revision", "id", "object_id", "kind", "role"],
  "properties": {
    "schema_version": {"const": 1},
    "revision": {"type": "integer", "minimum": 1},
    "id": {"type": "string", "minLength": 1},
    "object_id": {"type": "string", "minLength": 1},
    "kind": {"enum": ["chatgpt", "github", "local", "external"]},
    "role": {"enum": ["brain", "exec", "source", "publish", "reference", "identity"]},
    "resource_type": {"type": "string", "minLength": 1},
    "provider_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": ["string", "integer"]}
      }
    },
    "locator": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": ["string", "integer", "number", "boolean", "null"]}
    },
    "machine_id": {"type": "string", "minLength": 1},
    "realization_kind": {"enum": ["git", "directory", "container"]},
    "binds_to_surface_id": {"type": "string", "minLength": 1}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "local"}}, "required": ["kind"]},
      "then": {"required": ["machine_id"]}
    },
    {
      "if": {
        "properties": {"kind": {"not": {"const": "local"}}},
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "realization_kind": false,
          "binds_to_surface_id": false
        }
      }
    },
    {
      "if": {
        "properties": {"realization_kind": {"const": "git"}},
        "required": ["realization_kind"]
      },
      "then": {"required": ["binds_to_surface_id"]}
    },
    {
      "if": {
        "properties": {"realization_kind": {"enum": ["directory", "container"]}},
        "required": ["realization_kind"]
      },
      "then": {
        "properties": {"binds_to_surface_id": false}
      }
    },
    {
      "if": {"required": ["binds_to_surface_id"]},
      "then": {
        "properties": {"realization_kind": {"const": "git"}}
      }
    }
  ]
}
